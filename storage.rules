rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupID) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/groups/$(groupID)/members/$(request.auth.uid)
        );
    }

    function isGroupLeader(groupID) {
      return isGroupMember(groupID)
        && firestore.get(
          /databases/(default)/documents/groups/$(groupID)/members/$(request.auth.uid)
        ).data.role == 'leader';
    }

    function hasSafeFilename(fileName) {
      return fileName.matches(
        '^[a-z0-9][a-z0-9-]{0,47}-[a-f0-9]{8}\\.(jpg|jpeg|png|pdf|docx|xlsx|pptx|zip)$'
      );
    }

    function hasMatchingContentType(fileName) {
      return
        (request.resource.contentType == 'image/jpeg'
          && fileName.matches('.*\\.(jpg|jpeg)$'))
        || (request.resource.contentType == 'image/png'
          && fileName.matches('.*\\.png$'))
        || (request.resource.contentType == 'application/pdf'
          && fileName.matches('.*\\.pdf$'))
        || (request.resource.contentType ==
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          && fileName.matches('.*\\.docx$'))
        || (request.resource.contentType ==
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          && fileName.matches('.*\\.xlsx$'))
        || (request.resource.contentType ==
            'application/vnd.openxmlformats-officedocument.presentationml.presentation'
          && fileName.matches('.*\\.pptx$'))
        || (request.resource.contentType in [
              'application/zip',
              'application/x-zip-compressed'
            ]
          && fileName.matches('.*\\.zip$'));
    }

    function hasValidUploaderMetadata() {
      return request.resource.metadata.uploaderID is string
        && request.resource.metadata.uploaderID == request.auth.uid;
    }

    match /groups/{groupID}/tasks/{taskID}/attachments/{attachmentID}/{filename} {
      allow read: if isGroupMember(groupID);

      allow create: if isGroupMember(groupID)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && hasSafeFilename(filename)
        && hasMatchingContentType(filename)
        && hasValidUploaderMetadata();

      allow update: if false;

      allow delete: if isGroupMember(groupID)
        && (
          resource.metadata.uploaderID == request.auth.uid
          || isGroupLeader(groupID)
        );
    }

    match /groups/{groupID}/avatars/{userID}/avatar.jpg {
      allow read: if isGroupMember(groupID);
      allow create, update: if isGroupMember(groupID) && request.auth.uid == userID
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024;
      allow delete: if isGroupMember(groupID) && request.auth.uid == userID;
    }

    match /groups/{groupID}/agendaMaterials/{userID}/{fileID}/{filename} {
      allow read: if isGroupMember(groupID);
      allow create: if isGroupMember(groupID) && request.auth.uid == userID
        && resource == null && fileID.matches('^[a-f0-9-]{36}$')
        && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024
        && hasValidUploaderMetadata()
        && filename.matches('^file\\.(png|jpg|jpeg|pdf|docx|pptx|xlsx|zip|mov|mp4)$')
        && (hasMatchingContentType(filename)
          || (filename == 'file.mov' && request.resource.contentType == 'video/quicktime')
          || (filename == 'file.mp4' && request.resource.contentType == 'video/mp4'));
      allow update: if false;
      allow delete: if isGroupMember(groupID) && request.auth.uid == userID;
    }

    match /avatars/{userID}/{filename} {
      allow read: if isSignedIn() && request.auth.uid == userID;
      allow create: if isSignedIn() && request.auth.uid == userID
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024
        && filename.matches('^[a-f0-9-]{36}\\.jpg$');
      allow delete: if isSignedIn() && request.auth.uid == userID;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
