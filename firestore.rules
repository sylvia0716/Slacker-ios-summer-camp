rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupID) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupID)/members/$(request.auth.uid));
    }

    function isCurrentUser(userID) {
      return isSignedIn() && request.auth.uid == userID;
    }

    function hasValidMessageShape(messageID) {
      let data = request.resource.data;
      let baseKeys = ['id', 'senderID', 'senderName', 'text', 'kind', 'createdAt'];
      let legacyAnalysisKeys = [
        'id', 'senderID', 'senderName', 'text', 'kind', 'createdAt',
        'analysisScore', 'analysisStrength', 'analysisSuggestion'
      ];
      let projectAnalysisKeys = [
        'id', 'senderID', 'senderName', 'text', 'kind', 'createdAt',
        'analysisScore', 'analysisStrength', 'analysisSuggestion',
        'taskCompletionScore', 'discussionScore', 'collaborationScore',
        'problemSolvingScore', 'reliabilityScore'
      ];
      return data.keys().hasAll(baseKeys)
        && data.id == messageID
        && data.senderID == request.auth.uid
        && data.senderName is string
        && data.senderName.size() > 0
        && data.senderName.size() <= 60
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 4000
        && data.kind in ['message', 'botReply', 'botAnalysis']
        && data.createdAt == request.time
        && (
          (data.kind in ['message', 'botReply'] && data.keys().hasOnly(baseKeys))
          ||
          (data.kind == 'botAnalysis'
            && data.keys().hasAll(legacyAnalysisKeys)
            && (
              data.keys().hasOnly(legacyAnalysisKeys)
              || (
                data.keys().hasAll(projectAnalysisKeys)
                && data.keys().hasOnly(projectAnalysisKeys)
                && data.taskCompletionScore is int
                && data.taskCompletionScore >= 0
                && data.taskCompletionScore <= 100
                && data.discussionScore is int
                && data.discussionScore >= 0
                && data.discussionScore <= 100
                && data.collaborationScore is int
                && data.collaborationScore >= 0
                && data.collaborationScore <= 100
                && data.problemSolvingScore is int
                && data.problemSolvingScore >= 0
                && data.problemSolvingScore <= 100
                && data.reliabilityScore is int
                && data.reliabilityScore >= 0
                && data.reliabilityScore <= 100
              )
            )
            && data.analysisScore is int
            && data.analysisScore >= 0
            && data.analysisScore <= 100
            && data.analysisStrength is string
            && data.analysisStrength.size() > 0
            && data.analysisStrength.size() <= 4000
            && data.analysisSuggestion is string
            && data.analysisSuggestion.size() > 0
            && data.analysisSuggestion.size() <= 4000)
        );
    }

    function hasValidPresenceShape(userID) {
      let data = request.resource.data;
      return data.keys().hasAll(['userID', 'displayName', 'isOnline', 'lastSeenAt'])
        && data.keys().hasOnly(['userID', 'displayName', 'isOnline', 'lastSeenAt'])
        && data.userID == userID
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 60
        && data.isOnline is bool
        && data.lastSeenAt == request.time;
    }

    // Personal review history is published by trusted Cloud Functions only. It remains
    // available to its owner after leaving a completed group.
    match /users/{userID}/peerReviewProjects/{groupID} {
      allow read: if isCurrentUser(userID);
      allow write: if false;
    }

    function isGroupLeader(groupID) {
      return isGroupMember(groupID)
        && get(
          /databases/$(database)/documents/groups/$(groupID)/members/$(request.auth.uid)
        ).data.role == 'leader';
    }

    function taskExists(groupID, taskID) {
      return exists(
        /databases/$(database)/documents/groups/$(groupID)/tasks/$(taskID)
      );
    }

    function hasSafeIDs(groupID, taskID, attachmentID) {
      return groupID.matches('^[a-z0-9-]+$')
        && taskID.matches('^[a-z0-9-]+$')
        && attachmentID.matches('^[a-z0-9-]+$');
    }

    function hasSafeStoragePath(data, groupID, taskID, attachmentID) {
      return data.storagePath is string
        && data.storagePath.matches(
          '^groups/' + groupID + '/tasks/' + taskID
            + '/attachments/' + attachmentID
            + '/[a-z0-9][a-z0-9-]{0,47}-[a-f0-9]{8}'
            + '\\.(jpg|jpeg|png|pdf|docx|xlsx|pptx|zip)$'
        );
    }

    function hasMatchingFileType(data) {
      return
        (data.kind == 'image'
          && (
            (data.contentType == 'image/jpeg'
              && data.storagePath.matches('.*\\.(jpg|jpeg)$'))
            || (data.contentType == 'image/png'
              && data.storagePath.matches('.*\\.png$'))
          ))
        || (data.kind == 'pdf'
          && data.contentType == 'application/pdf'
          && data.storagePath.matches('.*\\.pdf$'))
        || (data.kind == 'document'
          && data.contentType ==
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          && data.storagePath.matches('.*\\.docx$'))
        || (data.kind == 'spreadsheet'
          && data.contentType ==
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          && data.storagePath.matches('.*\\.xlsx$'))
        || (data.kind == 'presentation'
          && data.contentType ==
            'application/vnd.openxmlformats-officedocument.presentationml.presentation'
          && data.storagePath.matches('.*\\.pptx$'))
        || (data.kind == 'archive'
          && data.contentType in [
            'application/zip',
            'application/x-zip-compressed'
          ]
          && data.storagePath.matches('.*\\.zip$'));
    }

    function hasValidLinkMetadata(data) {
      return data.kind == 'externalLink'
        && data.externalURL is string
        && data.externalURL.size() > 0
        && data.externalURL.size() <= 2048
        && data.externalURL.matches('^https://[^\\s]+$')
        && data.originalFilename == null
        && data.storagePath == null
        && data.contentType == null
        && data.byteSize == null;
    }

    function hasValidFileMetadata(data, groupID, taskID, attachmentID) {
      return data.kind in [
          'image', 'pdf', 'presentation', 'document', 'spreadsheet', 'archive'
        ]
        && data.externalURL == null
        && data.originalFilename is string
        && data.originalFilename.size() > 0
        && data.originalFilename.size() <= 255
        && hasSafeStoragePath(data, groupID, taskID, attachmentID)
        && data.contentType is string
        && data.byteSize is int
        && data.byteSize > 0
        && data.byteSize <= 20 * 1024 * 1024
        && hasMatchingFileType(data);
    }

    function hasValidAttachmentShape(groupID, taskID, attachmentID) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'taskID', 'groupID', 'uploaderID', 'title', 'detail', 'kind',
          'originalFilename', 'storagePath', 'externalURL', 'contentType',
          'byteSize', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'taskID', 'groupID', 'uploaderID', 'title', 'detail', 'kind',
          'originalFilename', 'storagePath', 'externalURL', 'contentType',
          'byteSize', 'status', 'createdAt'
        ])
        && hasSafeIDs(groupID, taskID, attachmentID)
        && data.id == attachmentID
        && data.taskID == taskID
        && data.groupID == groupID
        && data.uploaderID is string
        && data.uploaderID.size() > 0
        && data.uploaderID.size() <= 128
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.detail is string
        && data.detail.size() <= 1000
        && data.status in ['pending', 'uploading', 'ready', 'failed']
        && data.createdAt is timestamp
        && (
          hasValidLinkMetadata(data)
          || hasValidFileMetadata(data, groupID, taskID, attachmentID)
        );
    }

    match /profiles/{userID} {
      allow read: if isCurrentUser(userID);
      allow create, update: if isCurrentUser(userID)
        && request.resource.data.keys().hasOnly(['avatarPath'])
        && request.resource.data.avatarPath is string
        && request.resource.data.avatarPath.matches('^avatars/' + userID + '/[a-f0-9-]{36}\\.jpg$');
    }

    match /groups/{groupID} {
      allow read: if isGroupMember(groupID);
      allow write: if false;

      match /members/{userID} {
        allow read: if isGroupMember(groupID) || isCurrentUser(userID);

        // Only trusted Admin SDK / Cloud Functions may grant membership or roles.
        allow create: if false;

        // Preserve the deployed chat profile update; identity and role stay immutable.
        allow update: if isCurrentUser(userID)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarPath', 'avatarVersion'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarPath', 'avatarVersion'])
            || (request.resource.data.avatarPath == 'groups/' + groupID + '/avatars/' + userID + '/avatar.jpg'
              && request.resource.data.avatarVersion is string
              && request.resource.data.avatarVersion.size() <= 40))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
            || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 60));

        // The callable serializes exits with joins and schedules empty-group cleanup.
        allow delete: if false;
      }

      match /messages/{messageID} {
        allow read: if isGroupMember(groupID);
        allow create: if isGroupMember(groupID)
          && hasValidMessageShape(messageID);
        allow update, delete: if false;
      }

      match /readReceipts/{userID} {
        allow read: if isGroupMember(groupID);
        allow create, update: if isGroupMember(groupID)
          && isCurrentUser(userID)
          && request.resource.data.keys().hasAll(['messageID', 'readAt'])
          && request.resource.data.keys().hasOnly(['messageID', 'readAt'])
          && request.resource.data.messageID is string
          && request.resource.data.messageID.size() > 0
          && request.resource.data.messageID.size() <= 128
          && request.resource.data.readAt == request.time
          && exists(/databases/$(database)/documents/groups/$(groupID)/messages/$(request.resource.data.messageID));
        allow delete: if false;
      }

      match /chatSettings/{settingID} {
        allow read: if isGroupMember(groupID) && settingID == 'pin';
        allow create, update: if isGroupMember(groupID)
          && settingID == 'pin'
          && request.resource.data.keys().hasAll(['messageID', 'senderName', 'text'])
          && request.resource.data.keys().hasOnly(['messageID', 'senderName', 'text'])
          && request.resource.data.messageID is string
          && request.resource.data.messageID.size() > 0
          && request.resource.data.messageID.size() <= 128
          && exists(/databases/$(database)/documents/groups/$(groupID)/messages/$(request.resource.data.messageID))
          && request.resource.data.senderName == get(
            /databases/$(database)/documents/groups/$(groupID)/messages/$(request.resource.data.messageID)
          ).data.senderName
          && request.resource.data.text == get(
            /databases/$(database)/documents/groups/$(groupID)/messages/$(request.resource.data.messageID)
          ).data.text;
        allow delete: if isGroupMember(groupID) && settingID == 'pin';
      }

      match /presence/{userID} {
        allow read: if isGroupMember(groupID);
        allow create, update: if isGroupMember(groupID)
          && isCurrentUser(userID)
          && hasValidPresenceShape(userID);
        // Keep self-presence cleanup working even after leaving the group.
        allow delete: if isCurrentUser(userID);
      }

      // Raw submissions and score totals stay server-only so reviewers cannot be identified.
      match /peerReviewSubmissions/{reviewID} {
        allow read, write: if false;
      }

      match /peerReviewAggregates/{documentID} {
        allow read, write: if false;
      }

      // A member may only read their own list of completed review targets.
      match /peerReviewStates/{userID} {
        allow read: if isGroupMember(groupID) && isCurrentUser(userID);
        allow write: if false;
      }

      // This document contains only group-level counts and anonymized totals.
      match /peerReviewPublic/{documentID} {
        allow read: if isGroupMember(groupID) && documentID == 'summary';
        allow write: if false;
      }

      // Published only after everyone finishes; each member sees only comments received by them.
      match /peerReviewComments/{userID} {
        allow read: if isGroupMember(groupID) && isCurrentUser(userID);
        allow write: if false;
      }

      match /pokes/{pokeID} {
        allow read: if isGroupMember(groupID)
          && resource.data.recipientID == request.auth.uid;
        allow write: if false;
      }

      match /tasks/{taskID} {
        allow read: if isGroupMember(groupID);
        allow write: if false;

        match /attachments/{attachmentID} {
          allow read: if isGroupMember(groupID);

          allow create: if isGroupMember(groupID)
            && taskExists(groupID, taskID)
            && request.resource.data.uploaderID == request.auth.uid
            && request.resource.data.status == 'ready'
            && request.resource.data.createdAt == request.time
            && hasValidAttachmentShape(groupID, taskID, attachmentID);

          allow update: if isGroupMember(groupID)
            && resource.data.uploaderID == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'detail', 'status'
            ])
            && request.resource.data.createdAt == resource.data.createdAt
            && hasValidAttachmentShape(groupID, taskID, attachmentID);

          allow delete: if isGroupMember(groupID)
            && (
              resource.data.uploaderID == request.auth.uid
              || isGroupLeader(groupID)
            );
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
